# ==========================================
# IEM STUDENT ADMISSION PORTAL
# Production Environment Template
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# Database: SQLite
DB_DIALECT=sqlite
DB_STORAGE=database/iem_admission_portal.sqlite

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=5242880

# Frontend CORS
CLIENT_URL=http://localhost:4200

# Active Admission Cycle
ACTIVE_ADMISSION_CYCLE=2026-2027

# Admin provisioning - seed script only
SEED_ADMIN_NAME=IEM Admission Administrator
SEED_ADMIN_EMAIL=admin@iem.edu.in
SEED_ADMIN_PASSWORD=ReplaceWithAStrongPassword123!
SEED_ADMIN_PHONE=9876543210
